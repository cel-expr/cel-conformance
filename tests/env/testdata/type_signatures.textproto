# proto-file: ../../../proto/cel/expr/conformance/test/env/suite.proto
# proto-message: cel.expr.conformance.test.env.TestSuite

name: "type_signatures"
description: "Conformance tests for canonical CEL type signatures and aliases."

sections {
  name: "primitives"
  description: "Canonical primitive types and aliases."

  tests {
    name: "bool"
    description: "Canonical bool type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: bool\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            bool_value: true
          }
        }
      }
      deduced_type {
        primitive: BOOL
      }
      output {
        result_value {
          bool_value: true
        }
      }
    }
  }

  tests {
    name: "int"
    description: "Canonical int type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: int\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: int\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            int64_value: 42
          }
        }
      }
      deduced_type {
        primitive: INT64
      }
      output {
        result_value {
          int64_value: 42
        }
      }
    }
  }

  tests {
    name: "uint"
    description: "Canonical uint type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: uint\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: uint\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            uint64_value: 42
          }
        }
      }
      deduced_type {
        primitive: UINT64
      }
      output {
        result_value {
          uint64_value: 42
        }
      }
    }
  }

  tests {
    name: "double"
    description: "Canonical double type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: double\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: double\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            double_value: 3.14
          }
        }
      }
      deduced_type {
        primitive: DOUBLE
      }
      output {
        result_value {
          double_value: 3.14
        }
      }
    }
  }

  tests {
    name: "string"
    description: "Canonical string type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: string\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: string\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            string_value: "hello"
          }
        }
      }
      deduced_type {
        primitive: STRING
      }
      output {
        result_value {
          string_value: "hello"
        }
      }
    }
  }

  tests {
    name: "bytes"
    description: "Canonical bytes type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bytes\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: bytes\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            bytes_value: "abc"
          }
        }
      }
      deduced_type {
        primitive: BYTES
      }
      output {
        result_value {
          bytes_value: "abc"
        }
      }
    }
  }
}

sections {
  name: "timestamp"
  description: "Canonical timestamp type and protobuf alias."

  tests {
    name: "timestamp"
    description: "Canonical timestamp type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }

  tests {
    name: "timestamp_alias"
    description: "Alias google.protobuf.Timestamp normalizes to timestamp."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: google.protobuf.Timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }
}

sections {
  name: "duration"
  description: "Canonical duration type and protobuf alias."

  tests {
    name: "duration"
    description: "Canonical duration type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: duration\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: duration\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('30m500ms')"
      input {
        key: "x"
        value {
          expr: "duration('1h30m')"
        }
      }
      deduced_type {
        well_known: DURATION
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Duration] {
              seconds: 7200
              nanos: 500000000
            }
          }
        }
      }
    }
  }

  tests {
    name: "duration_alias"
    description: "Alias google.protobuf.Duration normalizes to duration."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: google.protobuf.Duration\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: duration\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('30m500ms')"
      input {
        key: "x"
        value {
          expr: "duration('1h30m')"
        }
      }
      deduced_type {
        well_known: DURATION
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Duration] {
              seconds: 7200
              nanos: 500000000
            }
          }
        }
      }
    }
  }
}

sections {
  name: "null"
  description: "Canonical null type and aliases."

  tests {
    name: "null"
    description: "Canonical null type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"null\"\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: \"null\"\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        null: NULL_VALUE
      }
      output {
        result_value {
          null_value: NULL_VALUE
        }
      }
    }
  }

  tests {
    name: "null_aliases"
    description: "Aliases null_type and google.protobuf.NullValue normalize to null."
    env_yaml:
      "variables:\n"
      "  - name: from_null_type\n"
      "    type: null_type\n"
      "  - name: from_null_value\n"
      "    type: google.protobuf.NullValue\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: from_null_type\n"
        "    type: \"null\"\n"
        "  - name: from_null_value\n"
        "    type: \"null\"\n"
    }
    expr_tests {
      name: "from_null_type"
      expr: "from_null_type"
      deduced_type {
        null: NULL_VALUE
      }
      output {
        result_value {
          null_value: NULL_VALUE
        }
      }
    }
    expr_tests {
      name: "from_null_value"
      expr: "from_null_value"
      deduced_type {
        null: NULL_VALUE
      }
      output {
        result_value {
          null_value: NULL_VALUE
        }
      }
    }
  }

  tests {
    name: "non_empty_null_value"
    description: "Non-empty default value for a null variable is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"null\"\n"
      "    value: anything\n"
    output {
      errors: "Failed to parse null constant"
    }
  }
}

sections {
  name: "list"
  description: "Canonical list type, dyn element parameter, and protobuf alias."

  tests {
    name: "list"
    description: "Basic and nested list type signatures."
    env_yaml:
      "variables:\n"
      "  - name: basic\n"
      "    type: \"list<int>\"\n"
      "  - name: nested\n"
      "    type: \"list<list<string>>\"\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: basic\n"
        "    type: \"list<int>\"\n"
        "  - name: nested\n"
        "    type: \"list<list<string>>\"\n"
    }
    expr_tests {
      name: "basic"
      expr: "basic"
      input {
        key: "basic"
        value {
          expr: "[1, 2]"
        }
      }
      deduced_type {
        list_type {
          elem_type {
            primitive: INT64
          }
        }
      }
      output {
        result_value {
          list_value {
            values {
              int64_value: 1
            }
            values {
              int64_value: 2
            }
          }
        }
      }
    }
    expr_tests {
      name: "nested"
      expr: "nested"
      input {
        key: "nested"
        value {
          expr: "[['a'], ['b']]"
        }
      }
      deduced_type {
        list_type {
          elem_type {
            list_type {
              elem_type {
                primitive: STRING
              }
            }
          }
        }
      }
      output {
        result_value {
          list_value {
            values {
              list_value {
                values {
                  string_value: "a"
                }
              }
            }
            values {
              list_value {
                values {
                  string_value: "b"
                }
              }
            }
          }
        }
      }
    }
  }

  tests {
    name: "list_dyn"
    description: "Bare list, list<dyn>, and google.protobuf.ListValue normalize to list<dyn>."
    env_yaml:
      "variables:\n"
      "  - name: bare\n"
      "    type: list\n"
      "  - name: explicit_dyn\n"
      "    type: \"list<dyn>\"\n"
      "  - name: list_value_alias\n"
      "    type: google.protobuf.ListValue\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: bare\n"
        "    type: \"list<dyn>\"\n"
        "  - name: explicit_dyn\n"
        "    type: \"list<dyn>\"\n"
        "  - name: list_value_alias\n"
        "    type: \"list<dyn>\"\n"
    }
    expr_tests {
      name: "bare"
      expr: "bare"
      input {
        key: "bare"
        value {
          expr: "[1, 'two']"
        }
      }
      deduced_type {
        list_type {
          elem_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          list_value {
            values {
              int64_value: 1
            }
            values {
              string_value: "two"
            }
          }
        }
      }
    }
    expr_tests {
      name: "explicit_dyn"
      expr: "explicit_dyn"
      input {
        key: "explicit_dyn"
        value {
          expr: "[1, 'two']"
        }
      }
      deduced_type {
        list_type {
          elem_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          list_value {
            values {
              int64_value: 1
            }
            values {
              string_value: "two"
            }
          }
        }
      }
    }
    expr_tests {
      name: "list_value_alias"
      expr: "list_value_alias"
      input {
        key: "list_value_alias"
        value {
          expr: "[1, 'two']"
        }
      }
      deduced_type {
        list_type {
          elem_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          list_value {
            values {
              int64_value: 1
            }
            values {
              string_value: "two"
            }
          }
        }
      }
    }
  }

  tests {
    name: "list_empty_params"
    description: "List type signature with empty type parameter list is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"list<>\"\n"
    output {
      errors: "empty type parameter list"
    }
  }

  tests {
    name: "list_too_many_params"
    description: "List type signature with more than one type parameter is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"list<int, string>\"\n"
    output {
      errors: "list expects at most 1 parameter"
    }
  }
}

sections {
  name: "map"
  description: "Canonical map type, dyn parameters, and protobuf alias."

  tests {
    name: "map"
    description: "Basic and nested map type signatures."
    env_yaml:
      "variables:\n"
      "  - name: basic\n"
      "    type: \"map<int, string>\"\n"
      "  - name: nested\n"
      "    type: \"map<string, list<int>>\"\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: basic\n"
        "    type: \"map<int,string>\"\n"
        "  - name: nested\n"
        "    type: \"map<string,list<int>>\"\n"
    }
    expr_tests {
      name: "basic"
      expr: "basic"
      input {
        key: "basic"
        value {
          expr: "{1: 'one'}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            primitive: INT64
          }
          value_type {
            primitive: STRING
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                int64_value: 1
              }
              value {
                string_value: "one"
              }
            }
          }
        }
      }
    }
    expr_tests {
      name: "nested"
      expr: "nested"
      input {
        key: "nested"
        value {
          expr: "{'k': [42]}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            primitive: STRING
          }
          value_type {
            list_type {
              elem_type {
                primitive: INT64
              }
            }
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                string_value: "k"
              }
              value {
                list_value {
                  values {
                    int64_value: 42
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  tests {
    name: "map_dyn"
    description: "Bare map, dyn key/value parameters, and google.protobuf.Struct alias."
    env_yaml:
      "variables:\n"
      "  - name: bare\n"
      "    type: map\n"
      "  - name: dyn_key\n"
      "    type: \"map<dyn, string>\"\n"
      "  - name: dyn_value\n"
      "    type: \"map<string, dyn>\"\n"
      "  - name: explicit_dyn\n"
      "    type: \"map<dyn, dyn>\"\n"
      "  - name: struct_alias\n"
      "    type: google.protobuf.Struct\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: bare\n"
        "    type: \"map<dyn,dyn>\"\n"
        "  - name: dyn_key\n"
        "    type: \"map<dyn,string>\"\n"
        "  - name: dyn_value\n"
        "    type: \"map<string,dyn>\"\n"
        "  - name: explicit_dyn\n"
        "    type: \"map<dyn,dyn>\"\n"
        "  - name: struct_alias\n"
        "    type: \"map<string,dyn>\"\n"
    }
    expr_tests {
      name: "bare"
      expr: "bare"
      input {
        key: "bare"
        value {
          expr: "{1: 'one', 'two': 2}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            dyn {}
          }
          value_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                int64_value: 1
              }
              value {
                string_value: "one"
              }
            }
            entries {
              key {
                string_value: "two"
              }
              value {
                int64_value: 2
              }
            }
          }
        }
      }
    }
    expr_tests {
      name: "dyn_key"
      expr: "dyn_key"
      input {
        key: "dyn_key"
        value {
          expr: "{1: 'one', 'two': 'two'}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            dyn {}
          }
          value_type {
            primitive: STRING
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                int64_value: 1
              }
              value {
                string_value: "one"
              }
            }
            entries {
              key {
                string_value: "two"
              }
              value {
                string_value: "two"
              }
            }
          }
        }
      }
    }
    expr_tests {
      name: "dyn_value"
      expr: "dyn_value"
      input {
        key: "dyn_value"
        value {
          expr: "{'a': 1, 'b': 'two'}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            primitive: STRING
          }
          value_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                string_value: "a"
              }
              value {
                int64_value: 1
              }
            }
            entries {
              key {
                string_value: "b"
              }
              value {
                string_value: "two"
              }
            }
          }
        }
      }
    }
    expr_tests {
      name: "explicit_dyn"
      expr: "explicit_dyn"
      input {
        key: "explicit_dyn"
        value {
          expr: "{1: 'one', 'two': 2}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            dyn {}
          }
          value_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                int64_value: 1
              }
              value {
                string_value: "one"
              }
            }
            entries {
              key {
                string_value: "two"
              }
              value {
                int64_value: 2
              }
            }
          }
        }
      }
    }
    expr_tests {
      name: "struct_alias"
      expr: "struct_alias"
      input {
        key: "struct_alias"
        value {
          expr: "{'a': 1, 'b': 'two'}"
        }
      }
      deduced_type {
        map_type {
          key_type {
            primitive: STRING
          }
          value_type {
            dyn {}
          }
        }
      }
      output {
        result_value {
          map_value {
            entries {
              key {
                string_value: "a"
              }
              value {
                int64_value: 1
              }
            }
            entries {
              key {
                string_value: "b"
              }
              value {
                string_value: "two"
              }
            }
          }
        }
      }
    }
  }

  tests {
    name: "map_wrong_param_count"
    description: "Map type signature with a single type parameter is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"map<int>\"\n"
    output {
      errors: "map expects 0 or 2 parameters"
    }
  }

  tests {
    name: "map_empty_params"
    description: "Map type signature with empty type parameter list is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"map<>\"\n"
    output {
      errors: "empty type parameter list"
    }
  }

  tests {
    name: "map_too_many_params"
    description: "Map type signature with three type parameters is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"map<int, string, bool>\"\n"
    output {
      errors: "map expects 0 or 2 parameters"
    }
  }
}

sections {
  name: "errors"
  description: "Invalid type signatures."

  tests {
    name: "unterminated_map"
    description: "Malformed map type signature missing value type and closing bracket."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"map<int,\"\n"
    output {
      errors: "Invalid type signature"
    }
  }

  tests {
    name: "duplicate_type_key"
    description: "Duplicate type keys in a variable definition are rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
      "    type: int\n"
    output {
      errors: "Duplicate key 'type'"
    }
  }
}
