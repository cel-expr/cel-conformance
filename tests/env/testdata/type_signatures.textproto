      name: "add_duration"
      expr: "x + duration('30m500ms')"
      input {
        key: "x"
        value {
          expr: "duration('1h30m')"
        }
      }
      deduced_type {
        well_known: DURATION
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Duration] {
              seconds: 7200
              nanos: 500000000
            }
          }
        }
      }
