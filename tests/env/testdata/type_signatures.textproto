# proto-file: ../../../proto/cel/expr/conformance/test/env/suite.proto
# proto-message: cel.expr.conformance.test.env.TestSuite

name: "type_signatures"
description: "Conformance tests for canonical CEL type signatures and aliases."

sections {
  name: "primitives"
  description: "Canonical primitive types and aliases."

  tests {
    name: "bool"
    description: "Canonical bool type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
      "    value: true\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: bool\n"
        "    value: true\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: BOOL
      }
      output {
        result_value {
          bool_value: true
        }
      }
    }
  }

  tests {
    name: "int"
    description: "Canonical int type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: int\n"
      "    value: 42\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: int\n"
        "    value: 42\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: INT64
      }
      output {
        result_value {
          int64_value: 42
        }
      }
    }
  }

  tests {
    name: "uint"
    description: "Canonical uint type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: uint\n"
      "    value: 42\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: uint\n"
        "    value: 42\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: UINT64
      }
      output {
        result_value {
          uint64_value: 42
        }
      }
    }
  }

  tests {
    name: "double"
    description: "Canonical double type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: double\n"
      "    value: 3.14\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: double\n"
        "    value: 3.14\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: DOUBLE
      }
      output {
        result_value {
          double_value: 3.14
        }
      }
    }
  }

  tests {
    name: "double_inf"
    description: "Canonical double type with positive infinity default value."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: double\n"
      "    value: .inf\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: double\n"
        "    value: .inf\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: DOUBLE
      }
      output {
        result_value {
          double_value: inf
        }
      }
    }
  }

  tests {
    name: "double_neg_inf"
    description: "Canonical double type with negative infinity default value."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: double\n"
      "    value: -.inf\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: double\n"
        "    value: -.inf\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: DOUBLE
      }
      output {
        result_value {
          double_value: -inf
        }
      }
    }
  }

  tests {
    name: "double_nan"
    description: "Canonical double type with NaN default value."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: double\n"
      "    value: .nan\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: double\n"
        "    value: .nan\n"
    }
    expr_tests {
      name: "default_value"
      expr: "x"
      deduced_type {
        primitive: DOUBLE
      }
      output {
        result_value {
          double_value: nan
        }
      }
    }
  }
}

sections {
  name: "timestamp"
  description: "Canonical timestamp type and protobuf alias."

  tests {
    name: "timestamp"
    description: "Canonical timestamp type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }

  tests {
    name: "timestamp_alias"
    description: "Alias google.protobuf.Timestamp normalizes to timestamp."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: google.protobuf.Timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }
}

sections {
  name: "errors"
  description: "Invalid type signatures."

  tests {
    name: "unterminated_map"
    description: "Malformed map type signature missing value type and closing bracket."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"map<int,\"\n"
    output {
      errors: "Invalid type signature"
    }
  }

  tests {
    name: "duplicate_type_key"
    description: "Duplicate type keys in a variable definition are rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
      "    type: int\n"
    output {
      errors: "Duplicate key 'type'"
    }
  }

  tests {
    name: "negative_uint_value"
    description: "Negative default value for a uint variable is rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: uint\n"
      "    value: -42\n"
    output {
      errors: "Failed to parse uint constant"
    }
  }
}
