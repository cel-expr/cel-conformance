# proto-file: ../../../proto/cel/expr/conformance/test/env/suite.proto
# proto-message: cel.expr.conformance.test.env.TestSuite

name: "type_signatures"
description: "Conformance tests for canonical CEL type signatures and aliases."

sections {
  name: "primitives"
  description: "Canonical primitive types and aliases."

  tests {
    name: "bool"
    description: "Canonical bool type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: bool\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            bool_value: true
          }
        }
      }
      deduced_type {
        primitive: BOOL
      }
      output {
        result_value {
          bool_value: true
        }
      }
    }
  }

  tests {
    name: "int"
    description: "Canonical int type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: int\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: int\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            int64_value: 42
          }
        }
      }
      deduced_type {
        primitive: INT64
      }
      output {
        result_value {
          int64_value: 42
        }
      }
    }
  }

  tests {
    name: "uint"
    description: "Canonical uint type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: uint\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: uint\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            uint64_value: 42
          }
        }
      }
      deduced_type {
        primitive: UINT64
      }
      output {
        result_value {
          uint64_value: 42
        }
      }
    }
  }

  tests {
    name: "double"
    description: "Canonical double type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: double\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: double\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            double_value: 3.14
          }
        }
      }
      deduced_type {
        primitive: DOUBLE
      }
      output {
        result_value {
          double_value: 3.14
        }
      }
    }
  }

  tests {
    name: "string"
    description: "Canonical string type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: string\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: string\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            string_value: "hello"
          }
        }
      }
      deduced_type {
        primitive: STRING
      }
      output {
        result_value {
          string_value: "hello"
        }
      }
    }
  }

  tests {
    name: "bytes"
    description: "Canonical bytes type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bytes\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: bytes\n"
    }
    expr_tests {
      name: "value"
      expr: "x"
      input {
        key: "x"
        value {
          value {
            bytes_value: "abc"
          }
        }
      }
      deduced_type {
        primitive: BYTES
      }
      output {
        result_value {
          bytes_value: "abc"
        }
      }
    }
  }
}

sections {
  name: "timestamp"
  description: "Canonical timestamp type and protobuf alias."

  tests {
    name: "timestamp"
    description: "Canonical timestamp type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }

  tests {
    name: "timestamp_alias"
    description: "Alias google.protobuf.Timestamp normalizes to timestamp."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: google.protobuf.Timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }
}

sections {
