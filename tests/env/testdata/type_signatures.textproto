# proto-file: ../../../proto/cel/expr/conformance/test/env/suite.proto
# proto-message: cel.expr.conformance.test.env.TestSuite

name: "type_signatures"
description: "Conformance tests for canonical CEL type signatures and aliases."

sections {
  name: "primitives"
  description: "Canonical primitive types and aliases."

  tests {
    name: "bool"
    description: "Canonical bool type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: bool\n"
    }
    expr_tests {
      name: "negation"
      expr: "!x"
      input {
        key: "x"
        value {
          value {
            bool_value: true
          }
        }
      }
      output {
        result_value {
          bool_value: false
        }
      }
    }
  }
}

sections {
  name: "timestamp"
  description: "Canonical timestamp type and protobuf alias."

  tests {
    name: "timestamp"
    description: "Canonical timestamp type."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }

  tests {
    name: "timestamp_alias"
    description: "Alias google.protobuf.Timestamp normalizes to timestamp."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: google.protobuf.Timestamp\n"
    output {
      exported_env_yaml:
        "variables:\n"
        "  - name: x\n"
        "    type: timestamp\n"
    }
    expr_tests {
      name: "add_duration"
      expr: "x + duration('1h')"
      input {
        key: "x"
        value {
          expr: "timestamp('2026-01-01T00:00:00Z')"
        }
      }
      output {
        result_value {
          object_value {
            [type.googleapis.com/google.protobuf.Timestamp] {
              seconds: 1767229200
            }
          }
        }
      }
    }
  }
}

sections {
  name: "errors"
  description: "Invalid type signatures."

  tests {
    name: "unterminated_map"
    description: "Malformed map type signature missing value type and closing bracket."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: \"map<int,\"\n"
    output {
      errors: "Invalid type signature"
    }
  }

  tests {
    name: "duplicate_type_key"
    description: "Duplicate type keys in a variable definition are rejected."
    env_yaml:
      "variables:\n"
      "  - name: x\n"
      "    type: bool\n"
      "    type: int\n"
    output {
      errors: "Duplicate key 'type'"
    }
  }
}
