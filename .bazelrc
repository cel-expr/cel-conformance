common --enable_bzlmod
# Use built-in protoc
common --incompatible_enable_proto_toolchain_resolution
common --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc=true

build --java_runtime_version=remotejdk_11
build --java_language_version=11

# Remove flag once cel-spec with https://github.com/cel-expr/cel-spec/issues/508 is used from BCR.
common --incompatible_autoload_externally=proto_library,cc_proto_library,java_proto_library
